# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./folders.db

# SMB / UNC Share — set to your shared folder path
# Windows UNC:  \\LOCAL-PC\PROJECT
# Linux mount:  /mnt/smb/project
SMB_ROOT=C:/Users/Kelly/Desktop/Repo/folderscaner/test_smb_root

# Scanner polling interval (seconds)
SCAN_INTERVAL=5

# FastAPI server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# SMB credentials (optional on Windows)
SMB_USERNAME=
SMB_PASSWORD=
SMB_DOMAIN=

# Export directory
EXPORT_DIR=./exports
